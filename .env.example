# Client (Vite). The Worker is same-origin in production.
# Copy to .env.local — never commit values.

# Optional: Vite `/api` proxy target when wrangler is not on 8787.
# LEADWELL_WORKER_ORIGIN=http://127.0.0.1:8787

# Dev-only email/password button. Compiled out of production.
# Create the user via Better Auth after the Worker is running (see RUNBOOK.md).
VITE_DEV_TEST_EMAIL=
VITE_DEV_TEST_PASSWORD=

# Offline sample-org build. Do not set for the real app.
# VITE_DEMO=1
