{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leadwell",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-01-15",
  "compatibility_flags": ["nodejs_compat"],
  // Static Vite build. Deep links fall back to index.html (same as Vercel SPA).
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // BETTER_AUTH_URL and ENVIRONMENT are not set here — wrangler vars ship to prod.
  // Local (`.dev.vars`): ENVIRONMENT=local and optionally BETTER_AUTH_URL=http://localhost:8787.
  // ENVIRONMENT=local is the only unset-URL fallback. Preview/prod: omit
  // ENVIRONMENT and set BETTER_AUTH_URL to the public Worker origin (RUNBOOK.md).
  "vars": {
    "ANTHROPIC_MODEL": "claude-sonnet-4-20250514",
    "ALLOWED_EMAILS": "phillipchan1@gmail.com"
  },
  // Replace `id` with a real Hyperdrive config before `wrangler deploy`.
  // Hyperdrive is Workers Paid. Local / Free preview uses DATABASE_URL.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/leadwell"
    }
  ],
  "observability": {
    "enabled": true
  },
  // workers.dev only. No routes, no custom domain. Do not deploy from CI.
  "env": {
    "preview": {
      "name": "leadwell-preview",
      "workers_dev": true,
      "preview_urls": true,
      "vars": {
        "ANTHROPIC_MODEL": "claude-sonnet-4-20250514",
        "ALLOWED_EMAILS": "phillipchan1@gmail.com"
      },
      // Empty on purpose: Hyperdrive is not inherited. Preview uses DATABASE_URL.
      "hyperdrive": []
    }
  }
}
