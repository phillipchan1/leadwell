# Copy this file to .env.local and fill in your Supabase project values.
# (See SETUP.md for where to find these.)

# Project URL — Supabase dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key — Supabase dashboard → Project Settings → API → anon public
# Safe to expose in the browser; row-level security is what protects data.
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# NOTE: the Anthropic API key is NOT set here anymore. It lives server-side in
# the Edge Function (set via `supabase secrets set ANTHROPIC_API_KEY=sk-ant-...`).

# --- Optional: dev test account -------------------------------------------
# Adds a "Continue as test user (dev)" button to the sign-in screen so the app
# can be driven signed-in without the Google account — useful for automated or
# agent-driven testing. Dev builds only; Vite compiles it out of production.
# Create the user first: Supabase dashboard → Authentication → Users → Add user
# → "Create new user", with Auto Confirm User checked. See SETUP.md.
VITE_DEV_TEST_EMAIL=
VITE_DEV_TEST_PASSWORD=
