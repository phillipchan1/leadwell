{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "polarch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "polarch-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview", "--", "--port", "4173"],
      "port": 4173
    },
    {
      "name": "polarch-demo",
      "runtimeExecutable": "env",
      "runtimeArgs": ["VITE_DEMO=1", "npx", "vite", "--port", "5191", "--strictPort"],
      "port": 5191
    }
  ]
}
