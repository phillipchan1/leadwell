{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "polarch",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-01-15",
  "compatibility_flags": ["nodejs_compat"],
  // Every deploy keeps dashboard-only vars (BETTER_AUTH_URL, AUTH_COOKIE_DOMAIN,
  // AUTH_EMAIL_FROM). keep_vars does NOT protect vars listed below, so never
  // put AUTH_EMAIL_FROM here (worker/src/config.check.ts enforces it).
  "keep_vars": true,
  // Static Vite build. Deep links fall back to index.html (same as Vercel SPA).
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // BETTER_AUTH_URL, TRUSTED_ORIGINS, AUTH_COOKIE_DOMAIN, and ENVIRONMENT
  // are not set here — wrangler vars ship to prod. Attach polarch.day in
  // the dashboard (RUNBOOK.md); then set BETTER_AUTH_URL=https://polarch.day
  // and AUTH_COOKIE_DOMAIN=polarch.day. Local (`.dev.vars`): ENVIRONMENT=local.
  // ENVIRONMENT=local is the only unset-URL fallback.
  "vars": {
    "OPENAI_MODEL": "gpt-5-mini",
    "CF_EMAIL_FROM": "Polarch <login@polarch.day>",
    "ALLOWED_EMAILS": "phillipchan1@gmail.com"
  },
  // Prod Hyperdrive `leadwell-neon` (an id, not a secret). Local dev uses
  // localConnectionString; preview has no Hyperdrive and uses DATABASE_URL.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "c18a2c83cf664a8d9fc9f40bcba47718",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/polarch"
    }
  ],
  // Cloudflare Email Service (Workers Paid). Primary magic-link sender from
  // login@polarch.day; Resend (AUTH_EMAIL_FROM) is the fallback on error.
  "send_email": [
    { "name": "EMAIL", "remote": true, "allowed_sender_addresses": ["login@polarch.day"] }
  ],
  "observability": {
    "enabled": true
  },
  // Preview stays on workers.dev. Custom domain (polarch.day) is attached
  // in the Cloudflare dashboard, not in this file. Do not deploy from CI.
  "env": {
    "preview": {
      "name": "polarch-preview",
      "workers_dev": true,
      "preview_urls": true,
      "vars": {
        "OPENAI_MODEL": "gpt-5-mini",
        "CF_EMAIL_FROM": "Polarch <login@polarch.day>",
        "ALLOWED_EMAILS": "phillipchan1@gmail.com"
      },
      // Empty on purpose: Hyperdrive is not inherited. Preview uses DATABASE_URL.
      "hyperdrive": [],
      "send_email": [
        { "name": "EMAIL", "remote": true, "allowed_sender_addresses": ["login@polarch.day"] }
      ]
    }
  }
}
