{
  "name": "leadwell",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "lint": "eslint .",
    "test": "npm run test:worker && npm run test:loopback && npm run test:migrate",
    "test:worker": "node --experimental-strip-types worker/src/authUrl.check.ts && node --experimental-strip-types worker/src/refuseTestUrl.check.ts && node --experimental-strip-types worker/src/auth.check.ts && node --experimental-strip-types worker/src/openai.check.ts && node --experimental-strip-types worker/src/store.check.ts && node --experimental-strip-types worker/src/auth.flow.check.ts",
    "test:loopback": "node scripts/prove-loopback.mjs",
    "test:migrate": "node scripts/prove-migrate.mjs",
    "cf:dev": "npm run build && wrangler dev",
    "cf:preview": "npm run build && wrangler deploy --env preview"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/extension-task-item": "^3.29.2",
    "@tiptap/extension-task-list": "^3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@tiptap/suggestion": "^3.29.2",
    "@untitledui/icons": "^0.0.22",
    "@xyflow/react": "^12.11.2",
    "better-auth": "^1.3.34",
    "hono": "^4.10.4",
    "pg": "^8.16.3",
    "pg-connection-string": "^2.9.1",
    "postgres": "^3.4.7",
    "react": "^19.2.8",
    "react-aria": "^3.51.0",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-react-aria-components": "^2.2.0",
    "tiptap-markdown": "^0.9.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261025.1",
    "@electric-sql/pglite": "^0.3.14",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.46.2",
    "vite": "^6.0.0",
    "wrangler": "^4.45.0"
  }
}
