# wrangler secrets / local vars. Copy to .dev.vars — never commit values.
# Names only in RUNBOOK.md.

ENVIRONMENT=local
# BETTER_AUTH_URL=http://localhost:8787
# TRUSTED_ORIGINS=http://localhost:5173
# AUTH_COOKIE_DOMAIN=
BETTER_AUTH_SECRET=
RESEND_API_KEY=
# Resend fallback sender (verified in Resend). Never a polarch.day address.
# AUTH_EMAIL_FROM=Polarch <login@usedayspring.app>
# Cloudflare EMAIL binding sends from CF_EMAIL_FROM (default Polarch <login@polarch.day>).
# wrangler dev uses the remote binding: it sends REAL mail.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# Comma-separated. Sign-up and sign-in only. Set to Phil's email.
ALLOWED_EMAILS=phillipchan1@gmail.com
# Optional Google sign-in (Worker secrets in prod). Both set = button on.
# Local redirect URI: http://localhost:8787/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/polarch
